<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/cream_background">

    <!-- BOTTOM NAVIGATION -->
    <LinearLayout
        android:id="@+id/settingsBottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:background="@color/khaki"
        android:elevation="8dp">

        <TextView
            android:id="@+id/settingsNavPantry"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Pantry"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/settingsNavRecipes"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Recipes"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/settingsNavSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Settings"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentTop="true"
        android:layout_above="@id/settingsBottomNavigation">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Settings"
                android:textColor="#1F1F1F"
                android:textSize="30sp"
                android:textStyle="bold"
                android:layout_marginBottom="24dp" />

            <!-- PROFILE SECTION -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profile"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#665B3F" />

            <TextView
                android:id="@+id/txtProfileName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="User"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#1F1F1F"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/txtProfileEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Email"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#4F4F4F"
                android:layout_marginBottom="24dp" />

            <!-- PREFERENCES SECTION -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Preferences"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#665B3F"
                android:layout_marginBottom="8dp" />

            <!-- EXPIRY REMINDERS TOGGLE -->
            <Switch
                android:id="@+id/switchNotifications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Expiring-soon alerts"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#2B2B2B"
                android:paddingTop="12dp"
                android:paddingBottom="12dp" />

            <!-- UNITS PREFERENCE TOGGLE -->
            <Switch
                android:id="@+id/switchUnits"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Unit preference (Imperial: oz / Metric: g)"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#2B2B2B"
                android:paddingTop="12dp"
                android:paddingBottom="12dp" />

            <!-- DARK MODE TOGGLE -->
            <Switch
                android:id="@+id/switchDarkMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dark mode"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#2B2B2B"
                android:paddingTop="12dp"
                android:paddingBottom="12dp" />

            <!-- CHANGE PASSWORD BUTTON -->
            <Button
                android:id="@+id/btnChangePassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Change Password"
                android:textColor="#1F1F1F"
                android:textStyle="bold"
                android:backgroundTint="#B8AA86"
                android:layout_marginTop="16dp" />

            <!-- CLEAR PANTRY BUTTON -->
            <Button
                android:id="@+id/btnClearPantry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Clear Pantry"
                android:textColor="#1F1F1F"
                android:textStyle="bold"
                android:backgroundTint="#B8AA86"
                android:layout_marginTop="12dp" />

            <!-- ABOUT BUTTON -->
            <Button
                android:id="@+id/btnAbout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="About"
                android:textColor="#1F1F1F"
                android:textStyle="bold"
                android:backgroundTint="#B8AA86"
                android:layout_marginTop="12dp" />

            <!-- LOGOUT BUTTON -->
            <Button
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Logout"
                android:layout_marginTop="24dp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:backgroundTint="#665B3F" />

        </LinearLayout>
    </ScrollView>

</RelativeLayout>
