<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/cream_background">

    <!-- TOP TOOLBAR -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/pantryToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_alignParentTop="true"
        android:background="@color/khaki"
        android:elevation="4dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Smart Pantry Manager"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:textStyle="bold" />

    </androidx.appcompat.widget.Toolbar>

    <!-- BOTTOM NAVIGATION -->
    <LinearLayout
        android:id="@+id/pantryBottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:background="@color/khaki"
        android:elevation="8dp">

        <TextView
            android:id="@+id/pantryNavPantry"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Pantry"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pantryNavRecipes"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Recipes"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pantryNavSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Settings"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- 40DP KHAKI ADD BUTTON FLOATING ABOVE BOTTOM NAV -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/addPantryButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/pantryBottomNavigation"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:contentDescription="Add ingredient"
        android:src="@android:drawable/ic_input_add"
        app:fabCustomSize="40dp"
        app:maxImageSize="20dp"
        app:backgroundTint="@color/khaki"
        app:tint="@color/black" />

    <!-- MAIN CONTENT AREA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/pantryToolbar"
        android:layout_above="@id/pantryBottomNavigation"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My Pantry"
            android:textColor="@color/black"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Ingredients currently available"
            android:textColor="@color/black"
            android:textSize="14sp" />

        <!-- SEARCH BAR -->
        <EditText
            android:id="@+id/pantrySearchInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@android:drawable/editbox_background_normal"
            android:hint="Search ingredients..."
            android:inputType="text"
            android:padding="12dp"
            android:textColor="@color/black"
            android:textSize="15sp" />

        <!-- EXPIRING SOON ALERT BANNER -->
        <LinearLayout
            android:id="@+id/pantryExpiryAlertBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#FFF3CD"
            android:orientation="horizontal"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/pantryExpiryAlertText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#856404"
                android:textSize="14sp"
                android:textStyle="bold"
                android:text="⚠️ Alert: 2 item(s) in your pantry are expiring soon!" />

        </LinearLayout>

        <!-- EMPTY MESSAGE -->
        <TextView
            android:id="@+id/emptyPantryText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:gravity="center"
            android:text="Your pantry is empty.\nAdd ingredients to get started."
            android:textColor="@color/black"
            android:textSize="17sp"
            android:visibility="gone" />

        <!-- RECYCLER VIEW WITH EXTRA BOTTOM PADDING FOR CLEARANCE -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/pantryRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="15dp"
            android:clipToPadding="false"
            android:paddingBottom="120dp" />

    </LinearLayout>

</RelativeLayout>
